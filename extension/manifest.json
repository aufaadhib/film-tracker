{
  "manifest_version": 3,
  "name": "Reelmark Watch Detector",
  "version": "0.7.47",
  "description": "Mendeteksi film dan episode yang selesai ditonton di layanan streaming.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://disneyplus.com/*",
    "https://www.disneyplus.com/*",
    "https://www.primevideo.com/*",
    "https://play.max.com/*",
    "http://localhost:3000/*",
    "https://reelmark.afana.id/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Reelmark",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["netflix-metadata.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://disneyplus.com/*",
        "https://www.disneyplus.com/*",
        "https://www.primevideo.com/*",
        "https://play.max.com/*"
      ],
      "js": ["config.js", "coverage.js", "sync.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
